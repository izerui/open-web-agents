{
  "name": "open-web-agents",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p ${PORT:-5678}",
    "build": "next build",
    "start": "next start -p ${PORT:-5678}",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "worker": "tsx src/worker.ts",
    "worker:prod": "node --import tsx src/worker.ts",
    "test:e2e": "bash scripts/e2e.sh",
    "test:e2e:run": "vitest run --config vitest.e2e.config.ts",
    "ci:dryrun": "bash scripts/ci-dryrun.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "@next/env": "^16.2.11",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@rive-app/react-webgl2": "^4.30.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.37",
    "ajv": "^8.20.0",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.36.0",
    "embla-carousel-react": "^8.6.0",
    "ioredis": "^5.4.0",
    "lucide-react": "^1.27.0",
    "media-chrome": "^4.19.2",
    "motion": "^12.42.2",
    "mysql2": "^3.11.0",
    "nanoid": "^6.0.0",
    "next": "^16.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-jsx-parser": "^2.4.1",
    "react-resizable-panels": "^4.12.2",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.28.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  }
}
