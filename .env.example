# 基础设施
OWA_DATABASE_URL=mysql://root:owa@localhost:3306/owa
OWA_REDIS_URL=redis://localhost:6379
# 会话工作空间根目录(必须可写;每会话一个独立子目录)
OWA_DATA_DIR=./data

# 平台默认模型凭证(用户未配置时的兜底;三级覆盖:请求 > 会话 > 用户 > 平台默认)
OWA_ANTHROPIC_BASE_URL=https://api.anthropic.com
OWA_ANTHROPIC_API_KEY=

# 登录会话签名 / 用户密钥加密的主密钥。生产必须显式设置(用 openssl rand -base64 32 生成)
OWA_SESSION_SECRET=
OWA_SECRET_KEY=
# 要求登录。仅本地开发可设 0 关闭
OWA_AUTH_REQUIRED=1

# OS 内核沙箱总开关。【留空 = 开】—— 代码默认就是开,生产不要动它。
#
# 【为什么不写死 0】这份模板是给部署者抄的。写死 0 等于让每个生产部署都裸跑:
# 沙箱是 Bash 的唯一围栏(路径守卫只管 Write/Edit/Read 这类参数里有明确路径的工具,
# 命令文本里的路径它管不了)。接口调用又是无人值守、不走审批的 ——
# 没沙箱 = agent 拿到一个无限制的 shell。
#
# macOS 本地开发才需要在自己的 .env.local 里设 0(seatbelt 会吞掉沙箱内 Bash 的 stdout),
# 那一行不入镜像。Linux 生产靠 bubblewrap,不受该问题影响。
#
# 【没有“降级裸跑”这一档】沙箱配了 failIfUnavailable:起不来就硬失败。
# 容器里需要 bubblewrap 且允许 user namespaces;若环境禁了 userns,
# 要么放开它(推荐),要么显式设 0 彻底不用沙箱。部署后先跑一条任务确认沙箱真的生效。
OWA_SANDBOX=

# stdio MCP 会在平台宿主机启动程序,默认关闭;仅可信单租户部署按需开启
OWA_ALLOW_STDIO_MCP=0

# 单个 worker 进程同时执行的运行数(同一会话仍串行),默认 4
OWA_WORKER_CONCURRENCY=

# webhook 允许投递到内网私有网段(10/8、172.16/12、192.168/16、100.64/10、fc00::/7)。
# 回调打到自家内网后端时设 1。回环、链路本地(含云元数据 169.254.169.254)始终禁止。
OWA_WEBHOOK_ALLOW_PRIVATE=0

# 集成测试用。【必须指向专用测试库】—— 契约测试会清表,库名须含 "test",
# 否则会被守卫拒绝(曾经指到开发库上把数据删了)
OWA_TEST_DATABASE_URL=
OWA_TEST_REDIS_URL=

# 是否开放自助注册(第一个账号始终可以注册并成为管理员)。关闭后由管理员在「账号管理」里建号
OWA_ALLOW_SIGNUP=1

# 同一来源地址每 15 分钟的登录/注册次数上限,0 关闭。按账号的登录限流(15 分钟 10 次)始终开启
OWA_AUTH_IP_RATE_LIMIT=30

# 接口调用(invoke)限流,只计新调用,幂等重放不计入;0 关闭。Redis 不可用时放行(额度仍兜底)
# 每把 API Key 每分钟上限(Key 可在接入中心单独调低;管理员可调高)
OWA_INVOKE_RATE_LIMIT_PER_KEY=60
# 每个智能体每分钟上限(所有 Key 合计)
OWA_INVOKE_RATE_LIMIT_PER_AGENT=600
